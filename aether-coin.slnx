<Solution>
  <!-- 虚拟币线的宿主：一个服务端（节点）+ 一个客户端（钱包）+ 一个离线验证器。
       引擎在 ① aether-ledger（库），本仓只做组合与发布——和 ⑧ aether-ctp-hosts 同一套「只引不产」纪律，
       区别是本仓只装虚拟币这一条线的宿主。 -->
  <Project Path="Aether.Ledger.Node/Aether.Ledger.Node.csproj" />
  <Project Path="Aether.Ledger.Wallet/Aether.Ledger.Wallet.csproj" />
  <Project Path="Aether.Ledger.Verify/Aether.Ledger.Verify.csproj" />
  <!-- 钱包 UI（2026-10-28）：共享 View/VM + 三个 head。移动 head 进解决方案只为 IDE 可见——
       CI 在 ubuntu 上只构建 Node/Wallet/Verify/Desktop（见 ci.yml），不碰 android/ios TFM。 -->
  <Project Path="Aether.Ledger.Wallet.App/Aether.Ledger.Wallet.App.csproj" />
  <Project Path="Aether.Ledger.Wallet.Desktop/Aether.Ledger.Wallet.Desktop.csproj" />
  <Project Path="Aether.Ledger.Wallet.Android/Aether.Ledger.Wallet.Android.csproj" />
  <Project Path="Aether.Ledger.Wallet.iOS/Aether.Ledger.Wallet.iOS.csproj" />
  <Project Path="tests/Aether.Ledger.Wallet.Tests/Aether.Ledger.Wallet.Tests.csproj" />
</Solution>
